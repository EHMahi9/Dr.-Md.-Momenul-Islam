# Server Runtime Configuration
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=https://drmomenul.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Corpus Path (Optional - defaults to app/data/promoted_corpus_manifest.json)
# CORPUS_MANIFEST_PATH=/app/app/data/promoted_corpus_manifest.json

# LLM Generation (Disabled by default in research prototype)
GENERATION_ENABLED=false
LLM_PROVIDER=disabled
LLM_MODEL_NAME=disabled
# LLM_API_KEY=your_api_key_here
